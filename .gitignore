# Raw generation traces are large (70MB+) and reproducible from the scripts.
# The findings, the calibrations and the verified SFT data are NOT reproducible
# cheaply, so they are tracked.
results/**/*.jsonl
results/*.jsonl
results/**/*.npz
results/runpod_*.json
results/ml-intern-postmortem/

# Derived Claim B parquets (regenerate: python -m rl.claimB_data)
rl/data/claimB/

# Raw generation corpora are large (100MB+) and reproducible from the Modal apps.
# The MEASURED outputs (hse_*.json, within_problem_*.json) are what the findings rest
# on and are tracked. GitHub rejects >100MB, which is how this was caught.
results/qwq/qwq_domains.json
results/**/*_traces.json
